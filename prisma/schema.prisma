generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// AUTH & RBAC
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(CHECKIN_STAFF)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
  checkIns      CheckIn[]
  verifiedPayments Payment[] @relation("VerifiedBy")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  EVENT_MANAGER
  PITCH_COORDINATOR
  REGISTRATION_MANAGER
  TRANSPORT_COORDINATOR
  CHECKIN_STAFF
}

// ============================================================
// EVENT CORE
// ============================================================

model Event {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  description String?  @db.Text
  disclaimer  String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  timezone    String   @default("Asia/Kolkata")
  venueName   String?
  venueAddress String?
  venueMapsUrl String?
  capacityPitches Int  @default(50)
  capacityPerDay  Int  @default(25)
  audienceCapacityPerDay Int @default(200)
  pitchDeadline DateTime
  pitchFeePaise Int    @default(1599900) // ₹15,999
  audienceFeePaise Int @default(159900)  // ₹1,599
  holdHours   Int      @default(48)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings    EventSetting[]
  pages       EventPage[]
  judges      Judge[]
  agendaDays  AgendaDay[]
  checklist   LaunchChecklistItem[]
  pitchApplications PitchApplication[]
  audienceRegistrations AudienceRegistration[]
  transportLocations TransportLocation[]
  spocs       Spoc[]

  @@map("events")
}

model EventSetting {
  id        String   @id @default(cuid())
  eventId   String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@map("event_settings")
}

model EventPage {
  id          String   @id @default(cuid())
  eventId     String
  slug        String
  title       String
  content     String?  @db.Text
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  metaTitle   String?
  metaDesc    String?
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sections    EventSection[]
  faqItems    FaqItem[]

  @@unique([eventId, slug])
  @@map("event_pages")
}

model EventSection {
  id        String   @id @default(cuid())
  pageId    String
  key       String
  title     String?
  content   String?  @db.Text
  sortOrder Int      @default(0)

  page      EventPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("event_sections")
}

model FaqItem {
  id        String   @id @default(cuid())
  pageId    String
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isPublished Boolean @default(true)

  page      EventPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("faq_items")
}

model LaunchChecklistItem {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  isDone      Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("launch_checklist")
}

// ============================================================
// JUDGES & AGENDA
// ============================================================

model Judge {
  id              String   @id @default(cuid())
  eventId         String
  name            String
  roleTitle       String
  feedbackAreas   String   @db.Text
  photoUrl        String?
  photoApproved   Boolean  @default(false)
  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(true)
  bio             String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("judges")
}

model AgendaDay {
  id        String   @id @default(cuid())
  eventId   String
  date      DateTime
  label     String   // e.g. "30 November 2026"
  note      String?  @db.Text
  sortOrder Int      @default(0)

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items     AgendaItem[]

  @@map("agenda_days")
}

model AgendaItem {
  id          String   @id @default(cuid())
  agendaDayId String
  startTime   String   // "09:00"
  endTime     String   // "09:15"
  activity    String
  sortOrder   Int      @default(0)

  agendaDay   AgendaDay @relation(fields: [agendaDayId], references: [id], onDelete: Cascade)

  @@map("agenda_items")
}

// ============================================================
// REGISTRATIONS
// ============================================================

enum PitchStatus {
  PENDING_PAYMENT
  PAYMENT_PROOF_SUBMITTED
  PAID
  UNDER_REVIEW
  CONFIRMED
  WAITLISTED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum AudienceStatus {
  PENDING_PAYMENT
  PAYMENT_PROOF_SUBMITTED
  PAID
  CONFIRMED
  CANCELLED
  REJECTED
}

model PitchApplication {
  id              String      @id @default(cuid())
  eventId         String
  registrationId  String      @unique // public facing ID
  founderName     String
  email           String
  mobile          String
  city            String
  designation     String?
  startupName     String
  website         String?
  industry        String?
  stage           String?     // idea | prototype | early_revenue | scaling
  yearFounded     Int?
  oneLiner        String?
  summary         String?     @db.Text
  problem         String?     @db.Text
  targetCustomers String?     @db.Text
  businessModel   String?     @db.Text
  traction        String?     @db.Text
  fundingRaised   String?
  wantsFromEvent  String?     @db.Text
  teamSize        Int?
  attendingCount  Int         @default(1) // 1-3
  preferredDay    String?     // "2026-11-30" | "2026-12-01" | "no_preference"
  pitchDeckUrl    String?
  status          PitchStatus @default(PENDING_PAYMENT)
  holdExpiresAt   DateTime?
  internalNotes   String?     @db.Text
  assignedDay     DateTime?
  pitchNumber     Int?
  startTime       String?
  isPublicListing Boolean     @default(false)
  schedulePublished Boolean   @default(false)
  consentAccepted Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment         Payment?
  tickets         Ticket[]
  answers         RegistrationAnswer[]

  @@index([email, startupName])
  @@index([status])
  @@map("pitch_applications")
}

model AudienceRegistration {
  id              String         @id @default(cuid())
  eventId         String
  registrationId  String         @unique
  fullName        String
  email           String
  mobile          String
  city            String?
  organization    String?
  attendeeType    String?        // student | founder | investor | professional | other
  interests       String?
  attendanceDay   DateTime
  quantity        Int            @default(1)
  status          AudienceStatus @default(PENDING_PAYMENT)
  holdExpiresAt   DateTime?
  consentAccepted Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment         Payment?
  tickets         Ticket[]
  answers         RegistrationAnswer[]

  @@index([email, attendanceDay])
  @@index([status])
  @@map("audience_registrations")
}

model RegistrationFormField {
  id          String   @id @default(cuid())
  formType    String   // "pitch" | "audience"
  key         String
  label       String
  fieldType   String   // text | textarea | select | number | checkbox
  options     String?  @db.Text // JSON
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  @@unique([formType, key])
  @@map("registration_form_fields")
}

model RegistrationAnswer {
  id                    String   @id @default(cuid())
  fieldKey              String
  value                 String   @db.Text
  pitchApplicationId    String?
  audienceRegistrationId String?

  pitchApplication      PitchApplication?    @relation(fields: [pitchApplicationId], references: [id], onDelete: Cascade)
  audienceRegistration  AudienceRegistration? @relation(fields: [audienceRegistrationId], references: [id], onDelete: Cascade)

  @@map("registration_answers")
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentStatus {
  PENDING
  PROOF_SUBMITTED
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
}

model Payment {
  id                String        @id @default(cuid())
  amountPaise       Int
  method            PaymentMethod?
  utr               String?
  payerName         String?
  proofUrl          String?
  status            PaymentStatus @default(PENDING)
  referenceCode     String        @unique
  rejectionReason   String?
  verifiedById      String?
  verifiedAt        DateTime?
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  pitchApplicationId    String?   @unique
  audienceRegistrationId String?  @unique

  pitchApplication      PitchApplication?    @relation(fields: [pitchApplicationId], references: [id], onDelete: Cascade)
  audienceRegistration  AudienceRegistration? @relation(fields: [audienceRegistrationId], references: [id], onDelete: Cascade)
  verifiedBy            User?                @relation("VerifiedBy", fields: [verifiedById], references: [id])
  refunds               Refund[]

  @@index([utr])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  amountPaise Int
  note        String   @db.Text
  createdAt   DateTime @default(now())
  createdById String?

  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

// ============================================================
// TICKETS & CHECK-IN
// ============================================================

enum TicketType {
  PITCH
  AUDIENCE
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

model Ticket {
  id                String       @id @default(cuid())
  ticketNumber      String       @unique
  verificationToken String       @unique
  type              TicketType
  status            TicketStatus @default(ACTIVE)
  holderName        String
  holderEmail       String?
  holderMobile      String?
  validDay          DateTime?    // for audience
  qrCodeDataUrl     String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  pitchApplicationId    String?
  audienceRegistrationId String?

  pitchApplication      PitchApplication?    @relation(fields: [pitchApplicationId], references: [id], onDelete: Cascade)
  audienceRegistration  AudienceRegistration? @relation(fields: [audienceRegistrationId], references: [id], onDelete: Cascade)
  checkIns              CheckIn[]

  @@index([verificationToken])
  @@map("tickets")
}

model CheckIn {
  id          String   @id @default(cuid())
  ticketId    String
  checkedInAt DateTime @default(now())
  staffId     String?
  notes       String?
  authorizedOverride Boolean @default(false)

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff       User?    @relation(fields: [staffId], references: [id])

  @@map("check_ins")
}

// ============================================================
// TRANSPORT
// ============================================================

model TransportLocation {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  suggestedFarePaise Int
  serviceStarts String   @default("07:00")
  exactPoint    String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requests      TransportRequest[]

  @@map("transport_locations")
}

enum TransportStatus {
  REQUESTED
  CONFIRMED
  WAITLISTED
  CANCELLED
  COMPLETED
}

model TransportRequest {
  id              String          @id @default(cuid())
  locationId      String
  name            String
  phone           String
  email           String
  ticketNumber    String?
  direction       String          // to_venue | from_venue | both
  eventDay        DateTime
  preferredTime   String?
  passengers      Int             @default(1)
  estimatedTotalPaise Int?
  status          TransportStatus @default(REQUESTED)
  exactPickupPoint String?
  confirmedTime   String?
  adminNotes      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  location        TransportLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("transport_requests")
}

// ============================================================
// SPOC
// ============================================================

model Spoc {
  id              String   @id @default(cuid())
  eventId         String
  name            String
  designation     String?
  email           String
  mobile          String
  whatsapp        String?
  photoUrl        String?
  responsibility  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments     SpocAssignment[]

  @@map("spocs")
}

model SpocAssignment {
  id          String   @id @default(cuid())
  spocId      String
  category    String   // pitch | audience | transport | general
  createdAt   DateTime @default(now())

  spoc        Spoc     @relation(fields: [spocId], references: [id], onDelete: Cascade)

  @@unique([spocId, category])
  @@map("spoc_assignments")
}

// ============================================================
// EMAIL
// ============================================================

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  subject     String
  heading     String?
  bodyHtml    String   @db.Text
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model EmailLog {
  id            String   @id @default(cuid())
  toEmail       String
  subject       String
  templateKey   String?
  status        String   // sent | delivered | bounced | failed
  resendId      String?
  errorMessage  String?
  sentAt        DateTime @default(now())
  metadata      String?  @db.Text

  @@index([toEmail])
  @@map("email_logs")
}

// ============================================================
// MISC
// ============================================================

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_enquiries")
}

model MediaAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  url         String
  filename    String?
  mimeType    String?
  sizeBytes   Int?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("media_assets")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  details     String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
